{
  "entities": {
    "ProjectMeta": {
      "title": "ProjectMeta",
      "description": "Metadata for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "genre": { "type": "string" },
        "audience": { "type": "string" },
        "logline": { "type": "string" },
        "wordGoal": { "type": "number" },
        "currentWords": { "type": "number" },
        "lastModified": { "type": "number" },
        "themeColor": { "type": "string" },
        "coverUrl": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "ProjectData": {
      "title": "ProjectData",
      "description": "Deep content of a novel project including manuscript, cast, atlas, and canon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "manuscript": { "type": "array" },
        "characters": { "type": "array" },
        "locations": { "type": "array" },
        "characterGraphs": { "type": "array" },
        "locationMap": { "type": "object" },
        "notes": { "type": "object" },
        "lastActiveSceneId": { "type": "string" },
        "lastActiveSceneTitle": { "type": "string" },
        "storyBible": { "type": "object" },
        "plotEvents": { "type": "array" },
        "plotArcs": { "type": "array" },
        "frontBackMatter": { "type": "object" }
      },
      "required": ["manuscript", "characters", "locations"]
    },
    "StudioTask": {
      "title": "StudioTask",
      "description": "User writing or editing task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "completed": { "type": "boolean" },
        "urgency": { "type": "string" },
        "createdAt": { "type": "number" },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "completed", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Author profile and writing studio preferences",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "penName": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "plan": { "type": "string" },
        "defaultFont": { "type": "string" },
        "fontSize": { "type": "string" },
        "defaultPov": { "type": "string" },
        "defaultTone": { "type": "string" },
        "theme": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "AuthorTimelineSettings": {
      "title": "AuthorTimelineSettings",
      "description": "Streak and writing time tracking configuration",
      "type": "object",
      "properties": {
        "streakMode": { "type": "string" },
        "customStreakDays": { "type": "number" },
        "timeMode": { "type": "string" },
        "customHours": { "type": "number" },
        "customMinutes": { "type": "number" },
        "activeDates": { "type": "array" },
        "totalWritingMinutesTracked": { "type": "number" }
      },
      "required": ["streakMode", "timeMode"]
    },
    "RegisteredUser": {
      "title": "RegisteredUser",
      "description": "System user account for CRM and admin dashboard",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "tier": { "type": "string" },
        "credits": { "type": "number" },
        "isBanned": { "type": "boolean" },
        "lastActive": { "type": "number" },
        "createdAt": { "type": "number" },
        "purchaseHistory": { "type": "array" }
      },
      "required": ["uid", "email"]
    },
    "IpnPendingPurchase": {
      "title": "IpnPendingPurchase",
      "description": "WarriorPlus pending purchase awaiting registration match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "productItem": { "type": "string" },
        "creditsAssigned": { "type": "number" },
        "tier": { "type": "string" },
        "dateReceived": { "type": "number" },
        "txnId": { "type": "string" }
      },
      "required": ["id", "buyerEmail", "productItem", "tier"]
    }
  },
  "firestore": {
    "users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectMeta" },
      "description": "Stores metadata about each project for a user"
    },
    "users/{userId}/projectData/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectData" },
      "description": "Stores the heavy content of the projects"
    },
    "users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/StudioTask" },
      "description": "Stores author studio tasks and checklist items"
    },
    "users/{userId}/profile/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores author profile, pen name, bio, and typography defaults"
    },
    "users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AuthorTimelineSettings" },
      "description": "Stores writing studio timeline and streak settings"
    },
    "registeredUsers/{userId}": {
      "schema": { "$ref": "#/entities/RegisteredUser" },
      "description": "Stores CRM account data for all registered users"
    },
    "ipnPendingPurchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/IpnPendingPurchase" },
      "description": "Stores pending WarriorPlus purchases for automatic fulfillment"
    }
  }
}
